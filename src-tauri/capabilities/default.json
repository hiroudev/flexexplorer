{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the FlexExplorer main window and any secondary windows it opens (e.g. \"open workspace in new window\"). Each entry corresponds to an API the app actually calls — see src/fs/bridge.ts.",
  "windows": ["main", "workspace-*"],
  "permissions": [
    "core:default",

    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",

    "core:window:allow-unminimize",
    "core:window:allow-show",
    "core:window:allow-set-focus",

    "core:webview:allow-create-webview-window",

    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",

    "drag:default"
  ]
}
